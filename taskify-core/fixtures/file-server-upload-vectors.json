{
  "opaqueUploads": [
    {
      "name": "opaque ciphertext name normalizes the digest and hides the original extension",
      "sha256": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "filename": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bin"
    }
  ],
  "routes": [
    {
      "name": "Originless current multipart endpoint",
      "type": "originless",
      "serverURL": "https://originless.example",
      "method": "POST",
      "uploadURL": "https://originless.example/up"
    },
    {
      "name": "Blossom BUD-01 endpoint",
      "type": "blossom",
      "serverURL": "https://blossom.example/base/",
      "method": "PUT",
      "uploadURL": "https://blossom.example/base/upload"
    }
  ],
  "uploadedURLs": [
    {
      "name": "Blossom descriptor behind a TLS proxy is published as https",
      "serverURL": "https://blossom.example",
      "url": "http://blossom.example/abc123.bin",
      "remoteURL": "https://blossom.example/abc123.bin"
    },
    {
      "name": "https descriptor is retained",
      "serverURL": "https://blossom.example",
      "url": "https://cdn.example/abc123.bin",
      "remoteURL": "https://cdn.example/abc123.bin"
    },
    {
      "name": "cleartext server keeps its own scheme",
      "serverURL": "http://blossom.example",
      "url": "http://blossom.example/abc123.bin",
      "remoteURL": "http://blossom.example/abc123.bin"
    },
    {
      "name": "local host has no certificate to upgrade to",
      "serverURL": "https://blossom.example",
      "url": "http://192.168.1.20:3000/abc123.bin",
      "remoteURL": "http://192.168.1.20:3000/abc123.bin"
    }
  ],
  "responses": [
    {
      "name": "Originless CID uses the shared public gateway",
      "serverURL": "https://originless.example",
      "payload": {
        "cid": "QmS5cF4AsRFFvHZW8pRRVk7XxN516jqcTeXMYwFJwRgWc1"
      },
      "remoteURL": "https://ipfs.filebase.io/ipfs/QmS5cF4AsRFFvHZW8pRRVk7XxN516jqcTeXMYwFJwRgWc1"
    },
    {
      "name": "Originless direct URL is retained",
      "serverURL": "https://originless.example",
      "payload": {
        "url": "https://files.example/encrypted.bin"
      },
      "remoteURL": "https://files.example/encrypted.bin"
    },
    {
      "name": "Originless relative path uses the server",
      "serverURL": "https://originless.example/base",
      "payload": {
        "path": "/objects/encrypted.bin"
      },
      "remoteURL": "https://originless.example/base/objects/encrypted.bin"
    }
  ]
}
