{
  "description": "Event RSVPs: an attendee's kind 30312 event (`d` <eventId>:<attendee>, `a` the event's canonical address, payload {v, eventId, status, inviteToken, fb?, note?}, NIP-44 to the board's key); the organizer's acceptance check (kind, author, address, payload, event id, then a token of the event's or the attendee's board-derived token, in that order); the board-derived token, base64(sha256(\"taskify-board-rsvp-token-v1\" ‖ \"<boardId>:<attendee>\")); and the newest response per attendee (on a tie the larger token), ordered by attendee. Written by taskify-core tests/calendar-rsvp-vectors.test.ts (WRITE_CALENDAR_RSVP_VECTORS=1); checked there and by Swift CalendarRsvpVectorTests.",
  "boardTokens": [
    {
      "name": "a board member's token",
      "input": {
        "boardId": "board-1",
        "attendeePubkey": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected": "qsWB3ZW3/AUqwwDLQNgykjjPUWHOSBol95XwU28bItM="
    },
    {
      "name": "the board id is trimmed and the key lowercased",
      "input": {
        "boardId": " board-1 ",
        "attendeePubkey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      },
      "expected": "qsWB3ZW3/AUqwwDLQNgykjjPUWHOSBol95XwU28bItM="
    },
    {
      "name": "another board and member",
      "input": {
        "boardId": "calendar-board-secret",
        "attendeePubkey": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expected": "7NUuyhwd3KjY4vXxTHqkcQmqVXgdx1UHf8pvu7WgnN0="
    }
  ],
  "plans": [
    {
      "name": "an acceptance",
      "input": {
        "canonical": "30310:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:event-1",
        "eventId": "event-1",
        "attendeePubkey": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "status": "accepted",
        "inviteToken": "token-a"
      },
      "expected": {
        "kind": "ready",
        "boardPubkey": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "canonicalAddress": "30310:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:event-1",
        "tags": [
          [
            "d",
            "event-1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          ],
          [
            "a",
            "30310:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:event-1"
          ]
        ],
        "payload": {
          "v": 1,
          "eventId": "event-1",
          "status": "accepted",
          "inviteToken": "token-a"
        }
      }
    },
    {
      "name": "a tentative answer with free/busy and a note, normalized",
      "input": {
        "canonical": "30310:CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC:event:part",
        "eventId": "event:part",
        "attendeePubkey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "status": "tentative",
        "inviteToken": "  token  ",
        "fb": "busy",
        "note": "  Running late  "
      },
      "expected": {
        "kind": "ready",
        "boardPubkey": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "canonicalAddress": "30310:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:event:part",
        "tags": [
          [
            "d",
            "event:part:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          ],
          [
            "a",
            "30310:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:event:part"
          ]
        ],
        "payload": {
          "v": 1,
          "eventId": "event:part",
          "status": "tentative",
          "inviteToken": "token",
          "fb": "busy",
          "note": "Running late"
        }
      }
    },
    {
      "name": "an unknown free/busy value and a blank note are left out",
      "input": {
        "canonical": "30310:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:event-1",
