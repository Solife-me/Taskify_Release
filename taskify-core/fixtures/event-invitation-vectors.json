{
  "description": "Calendar invitation secrets: tokens per invitee (sender excluded, duplicates merged, removed invitees dropped, existing tokens kept; between two spellings of one key, the lowercase-hex spelling's token, then the smallest), and the event key kept unless missing or not 32 bytes of base64. Generated tokens are token-1, token-2, … in invitee order; eventKey is \"kept\" or \"generated\". Written by taskify-core tests/event-invitation-vectors.test.ts (WRITE_EVENT_INVITATION_VECTORS=1); checked there and by Swift EventInvitationVectorTests.",
  "vectors": [
    {
      "name": "a new event gets a key and a token per invitee",
      "input": {
        "eventKey": null,
        "inviteTokens": null,
        "participantPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        ],
        "previousPubkeys": [],
        "senderPubkey": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      },
      "expected": {
        "eventKey": "generated",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "token-1",
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": "token-2"
        },
        "inviteePubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        ],
        "addedPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        ],
        "changed": true
      }
    },
    {
      "name": "existing tokens are kept, a new invitee gets one, a removed one loses theirs",
      "input": {
        "eventKey": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a",
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": "kept-b"
        },
        "participantPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        ],
        "previousPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        ],
        "senderPubkey": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      },
      "expected": {
        "eventKey": "kept",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a",
          "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc": "token-1"
        },
        "inviteePubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        ],
        "addedPubkeys": [
          "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        ],
        "changed": true
      }
    },
    {
      "name": "the sender is never their own invitee",
      "input": {
        "eventKey": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a"
        },
        "participantPubkeys": [
          "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "previousPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "senderPubkey": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      },
      "expected": {
        "eventKey": "kept",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a"
        },
        "inviteePubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "addedPubkeys": [],
        "changed": false
      }
    },
    {
      "name": "two spellings of one key are one invitee, and the canonical spelling's token wins",
      "input": {
        "eventKey": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "inviteTokens": {
          "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "upper",
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "lower"
        },
        "participantPubkeys": [
          "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "previousPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "senderPubkey": null
      },
      "expected": {
        "eventKey": "kept",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "lower"
        },
        "inviteePubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "addedPubkeys": [],
        "changed": true
      }
    },
    {
      "name": "invalid keys are not invitees",
      "input": {
        "eventKey": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "inviteTokens": null,
        "participantPubkeys": [
          "not-a-key",
          "",
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        ],
        "previousPubkeys": [],
        "senderPubkey": null
      },
      "expected": {
        "eventKey": "kept",
        "inviteTokens": {
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": "token-1"
        },
        "inviteePubkeys": [
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        ],
        "addedPubkeys": [
          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        ],
        "changed": true
      }
    },
    {
      "name": "a malformed event key is replaced",
      "input": {
        "eventKey": "short",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a"
        },
        "participantPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "previousPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "senderPubkey": null
      },
      "expected": {
        "eventKey": "generated",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a"
        },
        "inviteePubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "addedPubkeys": [],
        "changed": true
      }
    },
    {
      "name": "with nobody invited the tokens go",
      "input": {
        "eventKey": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a"
        },
        "participantPubkeys": [],
        "previousPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "senderPubkey": null
      },
      "expected": {
        "eventKey": "kept",
        "inviteTokens": null,
        "inviteePubkeys": [],
        "addedPubkeys": [],
        "changed": true
      }
    },
    {
      "name": "nothing to change",
      "input": {
        "eventKey": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a"
        },
        "participantPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "previousPubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "senderPubkey": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      },
      "expected": {
        "eventKey": "kept",
        "inviteTokens": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "kept-a"
        },
        "inviteePubkeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ],
        "addedPubkeys": [],
        "changed": false
      }
    }
  ]
}
