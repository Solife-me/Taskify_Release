{
  "name": "taskify-nostr",
  "version": "0.3.11",
  "description": "Nostr-powered task management CLI",
  "type": "module",
  "bin": {
    "taskify": "dist/index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "bundledDependencies": [],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nostr",
    "tasks",
    "cli",
    "productivity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solife-me/Taskify_Release.git"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "nostr-tools": "^2.23.5",
    "taskify-core": "file:../taskify-core",
    "taskify-runtime-nostr": "file:../taskify-runtime-nostr"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
