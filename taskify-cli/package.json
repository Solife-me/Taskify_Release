{
  "name": "taskify-nostr",
  "version": "0.5.0",
  "description": "Agent-facing CLI for Taskify collaboration over Nostr",
  "type": "module",
  "bin": {
    "taskify": "dist/index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "pretest": "npm run build",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bundledDependencies": [],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "nostr",
    "tasks",
    "cli",
    "productivity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solife-me/Taskify_Release.git"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "nostr-tools": "^2.25.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "esbuild": "^0.28.2",
    "taskify-core": "file:../taskify-core",
    "taskify-runtime-nostr": "file:../taskify-runtime-nostr",
    "typescript": "^6.0.3"
  }
}
