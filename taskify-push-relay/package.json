{
  "name": "taskify-push-relay",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Privacy-preserving NIP-17 relay and APNs bridge for Taskify",
  "scripts": {
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "check": "tsc --noEmit",
    "prettier": "prettier --write startos",
    "start": "node src/main.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "nostr-tools": "2.25.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "@types/node": "^22.20.2",
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  }
}
