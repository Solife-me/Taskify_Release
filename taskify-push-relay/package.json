{
  "name": "taskify-push-relay-startos",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "StartOS package for the Taskify Push Relay",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "check": "tsc --noEmit",
    "prettier": "prettier --write startos",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@start9labs/start-sdk": "3.1.0",
    "@types/node": "^26.6.4",
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  }
}
