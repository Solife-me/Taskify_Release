{
  "name": "taskify-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Taskify side panel for Brave: boards, upcoming, chat and settings, with page-context capture for AI agents.",
  "scripts": {
    "build": "vite build && node scripts/fix-output.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings tests/run-all.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "events": "^3.3.0",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "taskify-core": "file:../taskify-core",
    "taskify-runtime-nostr": "file:../taskify-runtime-nostr"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
